#!/usr/bin/env bash
# refresh — update local GitHub-activity data, then push new items to the
# "Work History" board's Incoming column.
#
# Wrapped in duct (per-run logs + resource usage) inside `datalad run`
# (provenance: records the command and saves history/ + .duct/logs/ in one
# commit). Quiet on success; on failure prints where to look. Safe from SOD.
#
#   ./refresh [RECENCY_DAYS]     # default 30; historia smart-update makes overlap cheap
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"                                       # ./history + .duct/logs/ resolve here, wherever invoked
recency="${1:-30}"
board="https://github.com/users/asmacdo/projects/7"
export PATH="$here/.venv-host/bin:$PATH"        # historia / duct / datalad from the venv

if ! GITHUB_TOKEN="$(gh auth token)"; then
    echo "refresh: 'gh auth token' failed — run 'gh auth login'" >&2; exit 1
fi
export GITHUB_TOKEN                              # in the env, NOT in the recorded command

update="duct historia update github --directory ./history --username asmacdo --recency $recency"
populate="duct historia project populate --directory ./history --url $board --status Incoming"

log="$(mktemp)"
if datalad run -d "$here" -m "refresh: update data + populate Incoming (recency=$recency)" \
       "$update && $populate" >"$log" 2>&1; then
    echo "historia refresh ok (recency=$recency)"
    /usr/bin/rm -f "$log"
else
    rc=$?
    echo "historia refresh FAILED (rc=$rc) — see $log and $here/.duct/logs/" >&2
    tail -n 25 "$log" >&2
    exit "$rc"
fi
